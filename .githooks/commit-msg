#!/usr/bin/env bash
set -euo pipefail

# Enforce commit message prefix: [NO-AI] or [AI-USED]
# This script receives the commit message file as $1

MSG_FILE="$1"
if [ -z "${MSG_FILE:-}" ] || [ ! -f "${MSG_FILE}" ]; then
  echo "commit-msg hook: missing message file" >&2
  exit 1
fi

first_line=$(sed -n '1p' "$MSG_FILE" | tr -d '\r' )
if [[ "$first_line" =~ ^\[(NO-AI|AI-USED)\] ]]; then
  exit 0
fi

cat >&2 <<'EOF'
ERROR: Commit message must start with [NO-AI] or [AI-USED]
Example: [AI-USED] fix: update README
Commit aborted.
EOF
exit 1
